{
  "name": "@codedeugteam/eolgae",
  "version": "0.2.0",
  "description": "SvelteKit 앱을 정적 SPA로 옮기는 공용 진입점(entry: 라우터·mount·page·goto·Vite 플러그인)과, 옛 빌드와 새 빌드가 같은지 다섯 축(스크린샷·DOM·네트워크·콘솔·WebSocket)으로 비교하는 패리티 하니스",
  "license": "MIT",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/entry/index.d.ts",
      "svelte": "./dist/entry/index.js",
      "default": "./dist/entry/index.js"
    },
    "./vite": {
      "types": "./dist/entry/plugin.d.ts",
      "default": "./dist/entry/plugin.js"
    },
    "./harness": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "eolgae-harness": "./dist/cli.js"
  },
  "files": [
    "dist",
    "harness/src",
    "README.md",
    "LICENSE",
    "entry/src",
    "template"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.entry.json",
    "prepare": "tsc -p tsconfig.json && tsc -p tsconfig.entry.json",
    "test": "node --test \"harness/test/**/*.test.ts\" \"entry/test/**/*.test.ts\"",
    "test:vite7": "npm install --no-save vite@7.3.1 @sveltejs/vite-plugin-svelte@6.2.4 && npm run build && npm test",
    "fixtures:changed": "node harness/fixtures/make-changed.ts"
  },
  "dependencies": {
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0"
  },
  "peerDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0 || ^7.0.0",
    "svelte": "^5.51.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "svelte": "^5.57.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
